{
  "name": "changevideospeed.github.io",
  "type": "module",
  "version": "1.0.0",
  "description": "ChangeVideoSpeed — Free Online Video Speed Controller (No Watermark, Zero Upload)",
  "scripts": {
    "postinstall": "node scripts/sync-ffmpeg.mjs",
    "dev": "node scripts/sync-ffmpeg.mjs && astro dev",
    "start": "npm run dev",
    "build": "node scripts/sync-ffmpeg.mjs && astro build && node scripts/generate-sw-manifest.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.5",
    "@astrojs/sitemap": "^3.7.4",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "typescript": "^5.9.3"
  }
}
